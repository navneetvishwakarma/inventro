# Copy to .env.local for development. Never commit real values (see AGENTS.md, ADR-0005, ADR-0004).
# None of these are wired up yet — S-01 only documents where they'll live; S-02/S-03/later stories make them functional.

# Supabase (S-02) — server-side only, never exposed to the client bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Single-household tenancy scaffold (ADR-0004, S-04). Fixed nil UUID S-02
# seeded catalog_items/categories against — every table's household_id
# points here in v1.
DEFAULT_HOUSEHOLD_ID=00000000-0000-0000-0000-000000000000

# Gemini (ingest LLM, ADR-0003)
GEMINI_API_KEY=

# Resend (transactional email)
RESEND_API_KEY=

# Passcode gate (S-03) — not real auth, see ADR-0004 / docs/architecture/06-security.md.
# GATE_COOKIE_SECRET signs the gate cookie; rotating it invalidates every session.
GATE_PASSCODE=
GATE_COOKIE_SECRET=
