# Copy to .env.local for development. Never commit real values (see AGENTS.md, ADR-0005, ADR-0004).
# None of these are wired up yet — S-01 only documents where they'll live; S-02/S-03/later stories make them functional.

# Supabase (S-02) — server-side only, never exposed to the client bundle.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# S-61/ADR-0006: same anon key as above, deliberately NOT NEXT_PUBLIC_-prefixed.
# createRequestClient() (lib/supabase/server.ts) reads this one -- it must
# never be inlined into the client bundle (that's what NEXT_PUBLIC_ would do).
SUPABASE_ANON_KEY=

# Single-household tenancy scaffold (ADR-0004, S-04). Fixed nil UUID S-02
# seeded catalog_items/categories against — every table's household_id
# points here in v1.
DEFAULT_HOUSEHOLD_ID=00000000-0000-0000-0000-000000000000

# Gemini (ingest LLM, ADR-0003)
GEMINI_API_KEY=

# Resend (transactional email, S-32/E-13 digests). RESEND_FROM_EMAIL must be
# an address on a domain verified in the Resend account -- Resend rejects
# unverified sending domains, so this can't default to a made-up address.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Passcode gate (S-03) — not real auth, see ADR-0004 / docs/architecture/06-security.md.
# GATE_COOKIE_SECRET signs the gate cookie; rotating it invalidates every session.
GATE_PASSCODE=
GATE_COOKIE_SECRET=

# Vercel Cron auth (S-16) — /api/cron/* checks Authorization: Bearer $CRON_SECRET
# and fails closed if unset. Must also be set in the Vercel project's environment.
CRON_SECRET=
